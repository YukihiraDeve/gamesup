# Configuration locale Docker. Ces valeurs d'exemple ne sont pas des secrets réels.
MYSQL_DATABASE=gamesup
MYSQL_USER=gamesup
MYSQL_PASSWORD=development-mysql-password-change-me
MYSQL_ROOT_PASSWORD=development-root-password-change-me

JWT_ISSUER=gamesup-api
JWT_ACCESS_TOKEN_TTL=PT1H
JWT_SECRET=development-jwt-signing-key-change-me-at-least-32-characters

FASTAPI_SERVICE_KEY=development-fastapi-key-change-me
FASTAPI_CONNECT_TIMEOUT=PT1S
FASTAPI_READ_TIMEOUT=PT3S
INTERNAL_API_CIDRS=172.28.0.0/24
KNN_NEIGHBORS=5

SPRING_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_ENV=development
